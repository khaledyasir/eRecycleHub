# Environment variables for the API (ASP.NET Core maps "__" to ":" in configuration keys).
# This file is documentation: set these as real environment variables on the host (see infra/DEPLOYMENT.md); the API does not read .env files by itself.
# Never commit real values. In production inject them from your host's secret store.

ASPNETCORE_ENVIRONMENT=Production

# SQL Server. Use a dedicated least-privilege login for the app; run migrations with a more privileged one.
ConnectionStrings__Default=Server=<host>;Database=<database>;User Id=<app-user>;Password=<set-in-secret-store>;Encrypt=True;TrustServerCertificate=False

# Public address of the website (used in e-mail links such as password reset). No trailing slash.
App__PublicUrl=https://www.example.com

# Uploaded files live OUTSIDE the web root and are served through /api/v1/files/{id}. Back this folder up with the database.
Storage__Root=/var/lib/erecyclehub/files

# Public base URL of THIS API, used to build absolute image/document URLs for the mobile app (…/api/v1/files/{id}).
# Empty = the request's own scheme and host. No trailing slash. The app's SERVER setting is this + /api/v1.
App__ApiPublicUrl=https://api.example.com

# Mobile bearer tokens (no refresh flow in the app, so long-lived).
# Sessions__TokenDays=30
# Mobile__Currency=JOD

# One-time codes (5 digits, 10 minutes, 5 tries, 5 sends per hour per phone/e-mail). There is no SMS provider yet:
# in Production, phone codes answer 503 OTP_UNAVAILABLE until one is added (ISmsSender); e-mail codes use the e-mail settings below.
# Otp__FixedCode=12345 (the default in appsettings.json): every code is 12345 and no SMS is sent. Set it empty to use random codes.

# How often (seconds) live auctions are checked for auction.started / auction.ended / auction.extended socket events.
# Realtime__PollSeconds=3

# E-mail. "Pickup" writes .html files to a folder and never sends anything (safe default for dev and test).
# "SendGrid" sends real e-mail: only set it in production.
Email__Provider=Pickup
Email__PickupDirectory=/var/lib/erecyclehub/mail
Email__FromAddress=no-reply@example.com
Email__FromName=eRecycleHub
# Email__SendGridApiKey=<set-in-secret-store>

# Rate limits per minute (defaults shown).
# RateLimits__AuthPerMinute=20
# RateLimits__FormsPerMinute=10
# RateLimits__BidsPerMinute=30
# RateLimits__MoneyPerMinute=10         # wallet top-up / withdrawal requests, per signed-in user
# RateLimits__AdminMoneyPerMinute=60    # administrator approve / reject / reverse / credit / void-sale, per administrator
# Wallet__MaxPendingRequests=5          # most Pending wallet requests (top-ups + withdrawals) one user may have at a time (1-100)

# Push notifications (Firebase Cloud Messaging). The service-account key JSON, as ONE environment variable / secret value
# (raw JSON, or the same JSON base64-encoded). Never put it in a file in the repo and never log it. Empty = push disabled.
# Firebase__Credentials=<set-in-secret-store>
# Capacity of the in-process background work queue (push subscriptions); full = work dropped and logged, rebuilt on the next sync.
# BackgroundWork__QueueCapacity=1000
# Rebuild every push-topic subscription from the database after lost work: dotnet ERecycleHub.Api.dll resync-topics

# Wallet-backed bidding. The flag keeps its original name, Bidding__DebitWallet, but its meaning is now HOLD-AND-PAY:
#   false (default): bids behave as before: the wallet only has to cover the auction's insurance amount, nothing is reserved, and the winner is NOT charged
#                    when the auction ends (payment is arranged outside the system).
#   true:            a bid RESERVES its amount (Bid.HeldAmount) but never debits the wallet: balance and ledger are untouched by a bid, a rebid, being outbid or a
#                    deactivation (those only release the hold). Available = balance - pending withdrawals - money held by the user's leading bids; withdrawals,
#                    admin debits and bids all use it, and a user may lead several auctions while the sum of their holds fits. When the auction ENDS the winner is
#                    debited the winning amount once (ledger reason AuctionPayment) in the same transaction as settling the bid. The money goes to the platform;
#                    there is no seller payout. Bids placed while this was false hold nothing and are never charged. Needs a restart to change.
# Money already held is still released when its bid is outbid or its auction is deactivated, and a held winner is still charged at close, whatever this is set to.
# Bidding__DebitWallet=false
# Check that balances, held bid money, payments and the ledger agree (read-only; exit code 1 on errors, warnings only print): dotnet ERecycleHub.Api.dll check-wallets
# Rebuild push-topic subscriptions from the database:                                                                      dotnet ERecycleHub.Api.dll resync-topics

# Closing ended auctions (settles the winner's hold, tells the participants). Runs on the shared in-process queue, so it needs the single API instance.
# AuctionEnd__Enabled=true
# AuctionEnd__PollSeconds=15          # how often ended auctions are looked for (1-300)
# AuctionEnd__LookbackHours=6         # winners of auctions that ended longer ago than this are not announced (so switching this on does not message old winners)
# The close job sends NO e-mail and does not touch WinnerNotifiedAtUtc; the admin "notify winners" e-mail flow is unchanged (the job uses Auctions.EndProcessedAtUtc).
