# Environment variables for the API (ASP.NET Core maps "__" to ":" in configuration keys).
# This file is documentation: set these as real environment variables on the host (see infra/DEPLOYMENT.md); the API does not read .env files by itself.
# Never commit real values. In production inject them from your host's secret store.

ASPNETCORE_ENVIRONMENT=Production

# SQL Server. Use a dedicated least-privilege login for the app; run migrations with a more privileged one.
ConnectionStrings__Default=Server=<host>;Database=<database>;User Id=<app-user>;Password=<set-in-secret-store>;Encrypt=True;TrustServerCertificate=False

# Public address of the website (used in e-mail links such as password reset). No trailing slash.
App__PublicUrl=https://www.example.com

# Uploaded files live OUTSIDE the web root and are served through /api/v1/files/{id}. Back this folder up with the database.
Storage__Root=/var/lib/erecyclehub/files

# Public base URL of THIS API, used to build absolute image/document URLs for the mobile app (…/api/v1/files/{id}).
# Empty = the request's own scheme and host. No trailing slash. The app's SERVER setting is this + /api/v1.
App__ApiPublicUrl=https://api.example.com

# Mobile bearer tokens (no refresh flow in the app, so long-lived).
# Sessions__TokenDays=30
# Mobile__Currency=JOD

# One-time codes (5 digits, 10 minutes, 5 tries, 5 sends per hour per phone/e-mail). There is no SMS provider yet:
# in Production, phone codes answer 503 OTP_UNAVAILABLE until one is added (ISmsSender); e-mail codes use the e-mail settings below.
# Otp__FixedCode is ignored in Production.

# How often (seconds) live auctions are checked for auction.started / auction.ended / auction.extended socket events.
# Realtime__PollSeconds=3

# E-mail. "Pickup" writes .html files to a folder and never sends anything (safe default for dev and test).
# "SendGrid" sends real e-mail: only set it in production.
Email__Provider=Pickup
Email__PickupDirectory=/var/lib/erecyclehub/mail
Email__FromAddress=no-reply@example.com
Email__FromName=eRecycleHub
# Email__SendGridApiKey=<set-in-secret-store>

# Rate limits per minute (defaults shown).
# RateLimits__AuthPerMinute=20
# RateLimits__FormsPerMinute=10
# RateLimits__BidsPerMinute=30
