{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": { "FormatterName": "json" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "App": {
    "PublicUrl": "http://localhost:3000"
  },
  "Storage": {
    "Root": "App_Data/files"
  },
  "Email": {
    "Provider": "Pickup",
    "PickupDirectory": "App_Data/mail",
    "FromAddress": "no-reply@erecyclehub.local",
    "FromName": "eRecycleHub"
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "FormsPerMinute": 10,
    "BidsPerMinute": 30
  }
}
